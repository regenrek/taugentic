{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "electron-builder.config.mjs",
    "eslint.config.mjs",
    "vite.config.ts",
    "packages/renderer/vite.config.ts",
    "scripts/launch-desktop.mjs",
    "scripts/package-layout.mjs",
    "scripts/stage-desktop-package.mjs",
    "tests/**/*.test.ts"
  ],
  "project": [
    "packages/*/src/**/*.{ts,tsx}",
    "packages/renderer/vite.config.ts",
    "tests/**/*.test.ts",
    "scripts/**/*.d.ts",
    "scripts/**/*.mjs"
  ],
  "ignoreFiles": [
    "packages/shared/generated/**/*.ts",
    "packages/preload/vite.config.ts",
    "packages/renderer/vite.config.ts"
  ],
  "ignoreDependencies": ["@vitejs/plugin-react", "@browser-echo/vite", "@tailwindcss/vite"],
  "ignoreUnresolved": ["electron"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "rules": {
    "duplicates": "off",
    "types": "error",
    "exports": "error"
  }
}
