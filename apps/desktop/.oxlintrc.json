{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/.artifacts/**",
    "packages/shared/generated/**"
  ]
}
