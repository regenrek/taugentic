{
  "$defs": {
    "BudgetScope": {
      "enum": [
        "run",
        "parentAggregate"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "parentRunId": {
      "type": [
        "string",
        "null"
      ]
    },
    "runId": {
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/BudgetScope"
    },
    "toolCalls": {
      "maxLength": 20,
      "pattern": "^[0-9]+$",
      "type": "string"
    },
    "totalTokens": {
      "maxLength": 20,
      "pattern": "^[0-9]+$",
      "type": "string"
    },
    "wallClockMs": {
      "maxLength": 20,
      "pattern": "^[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "runId",
    "scope",
    "totalTokens",
    "wallClockMs",
    "toolCalls"
  ],
  "title": "BudgetSnapshot",
  "type": "object"
}
