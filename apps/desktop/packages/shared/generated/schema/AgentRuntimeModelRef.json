{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "contextLimit": {
      "anyOf": [
        {
          "maxLength": 20,
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "displayName": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "inputCostPerMillionMicros": {
      "anyOf": [
        {
          "maxLength": 20,
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputModalities": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "outputCostPerMillionMicros": {
      "anyOf": [
        {
          "maxLength": 20,
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reasoning": {
      "type": "boolean"
    },
    "structuredOutput": {
      "type": "boolean"
    },
    "toolCall": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "displayName",
    "reasoning",
    "toolCall",
    "structuredOutput"
  ],
  "title": "AgentRuntimeModelRef",
  "type": "object"
}
