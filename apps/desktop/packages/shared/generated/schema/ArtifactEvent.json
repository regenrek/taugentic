{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "Transcript",
        "Patch",
        "FileSnapshot",
        "CommandLog"
      ],
      "type": "string"
    },
    "ArtifactSummary": {
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "runId": {
          "type": "string"
        },
        "storagePath": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "runId",
        "kind",
        "storagePath"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactSummary"
    }
  },
  "required": [
    "artifact"
  ],
  "title": "ArtifactEvent",
  "type": "object"
}
