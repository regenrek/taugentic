{
  "$defs": {
    "GitCheckpointPhase": {
      "enum": [
        "beforeTurn",
        "afterTurn"
      ],
      "type": "string"
    },
    "GitCheckpointSummary": {
      "properties": {
        "checkpointId": {
          "type": "string"
        },
        "createdAtMs": {
          "maxLength": 20,
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/GitCheckpointPhase"
        },
        "revision": {
          "maxLength": 20,
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "checkpointId",
        "workspaceId",
        "runId",
        "revision",
        "phase",
        "createdAtMs"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "checkpoints": {
      "items": {
        "$ref": "#/$defs/GitCheckpointSummary"
      },
      "type": "array"
    }
  },
  "required": [
    "checkpoints"
  ],
  "title": "GitCheckpointListResult",
  "type": "object"
}
