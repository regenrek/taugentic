{
  "$defs": {
    "RunStatus": {
      "enum": [
        "queued",
        "running",
        "waitingForApproval",
        "completed",
        "failed",
        "budgetExceeded",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "runtimeProfileId": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    }
  },
  "required": [
    "id",
    "runtimeProfileId",
    "objective",
    "status"
  ],
  "title": "RunSummary",
  "type": "object"
}
