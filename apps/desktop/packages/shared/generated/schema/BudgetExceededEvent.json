        "toolCalls": {
          "maxLength": 20,
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "totalTokens": {
          "maxLength": 20,
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "wallClockMs": {
          "maxLength": 20,
          "pattern": "^[0-9]+$",
          "type": "string"
        }
      },
