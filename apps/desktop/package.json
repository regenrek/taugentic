{
  "name": "@taugentic/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/main.tsx",
    "start": "bun src/main.tsx",
    "build:protocol": "pnpm --filter @taugentic/desktop-protocol build",
    "typecheck": "pnpm run build:protocol && tsc --noEmit",
    "check": "pnpm run typecheck && cargo xtask check-protocol",
    "test": "pnpm run build:protocol && bun test"
  },
  "dependencies": {
    "@gpuix/native": "0.4.0",
    "@gpuix/react": "0.4.0",
    "@taugentic/desktop-protocol": "workspace:*",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "25.0.10",
    "@types/react": "19.2.10",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "overrides": {
      "@gpuix/native": "0.4.0",
      "@gpuix/react": "0.4.0"
    }
  }
}
